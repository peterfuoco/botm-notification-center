NODE_ENV=development
PORT=3000

# Local Docker MySQL (see docker-compose.yml). Root is used locally so the
# integration test can create/drop its own notifications_test database.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=localdev
DB_NAME=notifications

# Stub admin auth (X-Admin-Key header)
ADMIN_API_KEY=local-admin-key
